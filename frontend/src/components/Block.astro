---
/**
 * Block Component
 *
 * Fetches and renders a content block by key.
 * Automatically selects the appropriate renderer based on block type.
 */

import { fetchBlock, type BlockData } from '../lib/blocks/api';
import Hero from '../blocks/Hero.astro';
import RichText from '../blocks/RichText.astro';
import ImageBlock from '../blocks/ImageBlock.astro';
import Cta from '../blocks/Cta.astro';
import FeatureGrid from '../blocks/FeatureGrid.astro';
import HtmlBlock from '../blocks/HtmlBlock.astro';

interface Props {
  key: string;
  preview?: boolean;
  fallback?: any;
}

const { key, preview = false, fallback } = Astro.props;

// Fetch the block
const block: BlockData | null = await fetchBlock(key, preview);

// If block not found and no fallback, render nothing
if (!block && !fallback) {
  // In development, show a placeholder
  if (import.meta.env.DEV) {
    console.warn(`Block "${key}" not found`);
  }
}

// Use fallback if block not found
const blockData = block || fallback;

// Component map for block types
const componentMap: Record<string, any> = {
  hero: Hero,
  richText: RichText,
  image: ImageBlock,
  cta: Cta,
  featureGrid: FeatureGrid,
  html: HtmlBlock,
};
---

{blockData ? (
  <>
    {(() => {
      const Component = componentMap[blockData.type];

      if (!Component) {
        // Unknown block type - safe fallback
        if (import.meta.env.DEV) {
          return (
            <div class="p-4 border-2 border-red-500 bg-red-50 text-red-700">
              <strong>Unknown block type:</strong> {blockData.type}
            </div>
          );
        }
        return null;
      }

      return <Component data={blockData.data} />;
    })()}
  </>
) : (
  import.meta.env.DEV && (
    <div class="p-4 border-2 border-yellow-500 bg-yellow-50 text-yellow-700">
      <strong>Block not found:</strong> {key}
    </div>
  )
)}
