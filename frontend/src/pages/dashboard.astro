---
// src/pages/dashboard.astro
import Layout from '../layouts/Layout.astro'
import { requireAuth } from '../lib/auth'

const user = await requireAuth(Astro)
if (user.redirected === false) {
  return user
}
const error = null
const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000'

// If your backend returns `avatar_url` (recommended), use it.
// Otherwise, fall back to building a URL from `avatar_path`.
const avatarUrl =
  user?.avatar_url ??
  (user?.avatar_path ? `${API}/storage/${String(user.avatar_path).replace(/^\/?storage\/?/, '')}` : null)
---

<Layout title="Dashboard" isLoggedIn={true} isAdmin={user.roles.includes('admin')}>
  <div class="min-h-screen bg-gray-100 dark:bg-gray-900">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {error ? (
        <div class="bg-red-100 dark:bg-red-900 border border-red-400 dark:border-red-700 text-red-700 dark:text-red-200 px-4 py-3 rounded mb-6">
          {error}
        </div>
      ) : (
        <>
          <!-- Profile Section -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-8 transition-colors">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Profile</h2>

            {user && (
              <div class="flex items-start gap-6">
                <!-- Avatar -->
                <div class="shrink-0">
                  <div class="w-24 h-24 rounded-full overflow-hidden bg-gray-200 dark:bg-gray-700 flex items-center justify-center">
                    {avatarUrl ? (
                      <img
                        id="avatarImg"
                        src={avatarUrl}
                        alt={`${user.name} avatar`}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <div id="avatarPlaceholder" class="w-full h-full flex items-center justify-center">
                        <label
                          for="avatarInput"
                          class="cursor-pointer text-sm text-gray-700 dark:text-gray-200 px-3 py-2 rounded bg-white/70 dark:bg-gray-800/70 hover:bg-white dark:hover:bg-gray-800 border border-gray-300 dark:border-gray-600"
                          title="Upload an avatar"
                        >
                          Upload
                        </label>
                      </div>
                    )}
                  </div>

                  <!-- Upload controls (always present; shown/used when needed) -->
                  <form id="avatarForm" class="mt-3 space-y-2" enctype="multipart/form-data">
                    <input
                      id="avatarInput"
                      name="avatar"
                      type="file"
                      accept="image/*"
                      class="block w-full text-sm text-gray-700 dark:text-gray-200
                             file:mr-3 file:py-2 file:px-3 file:rounded file:border-0
                             file:text-sm file:font-semibold
                             file:bg-gray-200 file:text-gray-800
                             dark:file:bg-gray-700 dark:file:text-gray-100
                             hover:file:bg-gray-300 dark:hover:file:bg-gray-600"
                    />

                    <div class="flex items-center gap-2">
                      <button
                        id="avatarUploadBtn"
                        type="submit"
                        class="text-sm px-3 py-2 rounded bg-gray-900 text-white hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100"
                      >
                        Save avatar
                      </button>

                      <button
                        id="avatarRemoveBtn"
                        type="button"
                        class="text-sm px-3 py-2 rounded border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700"
                        style={avatarUrl ? '' : 'display:none;'}
                      >
                        Remove
                      </button>
                    </div>

                    <p id="avatarStatus" class="text-xs text-gray-600 dark:text-gray-400"></p>
                  </form>
                </div>

                <!-- Profile fields -->
                <div class="space-y-2 flex-1">
                  <div class="flex items-center">
                    <span class="text-gray-600 dark:text-gray-400 font-medium w-24">Name:</span>
                    <span class="text-gray-900 dark:text-white">{user.name}</span>
                  </div>
                  <div class="flex items-center">
                    <span class="text-gray-600 dark:text-gray-400 font-medium w-24">Email:</span>
                    <span class="text-gray-900 dark:text-white">{user.email}</span>
                  </div>
                  <div class="flex items-center">
                    <span class="text-gray-600 dark:text-gray-400 font-medium w-24">Member Since:</span>
                    <span class="text-gray-900 dark:text-white">
                      {new Date(user.created_at).toLocaleDateString()}
                    </span>
                  </div>
                </div>
              </div>
            )}
          </div>
        </>
      )}
    </main>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_API_URL ?? 'http://localhost:8000'
    import { ensureCsrfCookie } from '../lib/auth'

    // Avatar upload/remove
    const avatarForm = document.getElementById('avatarForm')
    const avatarInput = document.getElementById('avatarInput')
    const avatarImg = document.getElementById('avatarImg')
    const avatarPlaceholder = document.getElementById('avatarPlaceholder')
    const avatarRemoveBtn = document.getElementById('avatarRemoveBtn')
    const avatarStatus = document.getElementById('avatarStatus')

    const setStatus = (msg) => {
      if (avatarStatus) avatarStatus.textContent = msg ?? ''
    }

    const setAvatar = (url) => {
      if (url) {
        if (avatarImg) {
          avatarImg.src = url
          avatarImg.style.display = ''
        } else {
          // If no <img> existed because we rendered placeholder, swap it in:
          const wrapper = document.querySelector('.w-24.h-24.rounded-full.overflow-hidden')
          if (wrapper) {
            wrapper.innerHTML = `<img id="avatarImg" src="${url}" alt="avatar" class="w-full h-full object-cover" loading="lazy" />`
          }
        }
        if (avatarRemoveBtn) avatarRemoveBtn.style.display = ''
      } else {
        // remove -> revert to placeholder upload label
        const wrapper = document.querySelector('.w-24.h-24.rounded-full.overflow-hidden')
        if (wrapper) {
          wrapper.innerHTML = `
            <div id="avatarPlaceholder" class="w-full h-full flex items-center justify-center">
              <label
                for="avatarInput"
                class="cursor-pointer text-sm text-gray-700 dark:text-gray-200 px-3 py-2 rounded bg-white/70 dark:bg-gray-800/70 hover:bg-white dark:hover:bg-gray-800 border border-gray-300 dark:border-gray-600"
                title="Upload an avatar"
              >Upload</label>
            </div>
          `
        }
        if (avatarRemoveBtn) avatarRemoveBtn.style.display = 'none'
      }
    }

    avatarForm?.addEventListener('submit', async (e) => {
      e.preventDefault()
      setStatus('')

      const file = avatarInput?.files?.[0]
      if (!file) {
        setStatus('Choose an image first.')
        return
      }

      try {
        console.log('Uploading avatar file:', file)
        setStatus('Uploading...')
        await ensureCsrfCookie()

        const fd = new FormData()
        fd.append('avatar', file)

        const res = await fetch(`${API}/api/user/avatar`, {
          method: 'PUT',
          body: fd,
          credentials: 'include',
        })

        if (!res.ok) {
          const txt = await res.text()
          console.error('Avatar upload failed:', txt)
          setStatus('Upload failed. See console.')
        } else {
          const data = await res.json()
          // Cache-bust so you immediately see the new image
          const url = data.avatar_url ? `${data.avatar_url}${data.avatar_url.includes('?') ? '&' : '?'}t=${Date.now()}` : null
          if (url) setAvatar(url)
          setStatus('Saved.')
        }
      } catch (err) {
        console.error(err)
        setStatus('Upload failed. See console.')
      }
    })

    avatarRemoveBtn?.addEventListener('click', async () => {
      setStatus('')
      try {
        setStatus('Removing...')
        await ensureCsrfCookie()

        const res = await fetch(`${API}/api/user/avatar`, {
          method: 'DELETE',
          credentials: 'include',
        })

        if (!res.ok) {
          const txt = await res.text()
          console.error('Avatar remove failed:', txt)
          setStatus('Remove failed. See console.')
          return
        }

        setAvatar(null)
        if (avatarInput) avatarInput.value = ''
        setStatus('Removed.')
      } catch (err) {
        console.error(err)
        setStatus('Remove failed. See console.')
      }
    })
  </script>
</Layout>
