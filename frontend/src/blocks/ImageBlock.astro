---
/**
 * Image Block Renderer
 *
 * Renders a single image with optional caption.
 */

interface Props {
  data: {
    url: string;
    alt?: string;
    caption?: string;
  };
}

const { data } = Astro.props;
---

<figure class="my-8">
  <img
    src={data.url}
    alt={data.alt || ''}
    class="w-full h-auto rounded-lg shadow-lg"
  />

  {data.caption && (
    <figcaption class="mt-2 text-center text-sm text-gray-600">
      {data.caption}
    </figcaption>
  )}
</figure>
