---
// src/layouts/Layout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro'

interface Props {
  title: string;
  isLoggedIn?: boolean;
  isAdmin?: boolean;
}

const { title, isLoggedIn, isAdmin } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Laravel Breeze + Astro.js" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script type="module" src="/src/scripts/globals.ts"></script>
    <script is:inline>
      // Prevent flash of wrong theme
      if (localStorage.getItem('theme') === 'dark' || 
          (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="h-full bg-gray-50 dark:bg-gray-900 transition-colors duration-200">
    <Navbar showAuthButtons={!isLoggedIn} showLogout={isLoggedIn} isAdmin={isAdmin} />
    <slot />
  </body>
</html>