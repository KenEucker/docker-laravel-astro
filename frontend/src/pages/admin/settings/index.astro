---
import Layout from '../../../layouts/Layout.astro'
import { requireAdmin } from '../../../lib/auth'

const admin = await requireAdmin(Astro)
if (admin.redirected === false) {
  return admin
}

// Hybrid approach:
// - SSR blocks non-admins immediately (above)
// - Table data loads client-side (below) using browser cookies automatically
---

<Layout title="Admin · Settings" isLoggedIn={true} isAdmin={admin.is_admin}>
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold mb-2">Application Settings</h1>
        <p class="text-sm text-gray-600 dark:text-gray-300">
          Manage application-wide settings. Database values override environment variables.
        </p>
      </div>
      <button
        id="add-setting-btn"
        class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700"
      >
        + Add Setting
      </button>
    </div>

    <div id="status" class="mb-4 text-sm text-gray-600 dark:text-gray-300"></div>

    <div class="overflow-x-auto rounded-lg border">
      <table class="w-full border-collapse">
        <thead class="bg-gray-100 dark:bg-gray-800">
          <tr>
            <th class="text-left px-4 py-2">Key</th>
            <th class="text-left px-4 py-2">Value</th>
            <th class="text-left px-4 py-2">Type</th>
            <th class="text-left px-4 py-2">Public</th>
            <th class="text-left px-4 py-2">Description</th>
            <th class="text-left px-4 py-2">Actions</th>
          </tr>
        </thead>
        <tbody id="settings-body">
          <tr><td class="px-4 py-3" colspan="6">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Add/Edit Modal -->
  <div id="setting-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-xl p-6 max-w-2xl w-full mx-4">
      <h2 id="modal-title" class="text-xl font-bold mb-4 text-gray-900 dark:text-gray-100">Add Setting</h2>
      <form id="setting-form" class="space-y-4">
        <input type="hidden" id="setting-id" />

        <div>
          <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Key</label>
          <input
            type="text"
            id="setting-key"
            required
            class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100"
            placeholder="APP_NAME"
          />
        </div>

        <div>
          <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Value</label>
          <textarea
            id="setting-value"
            rows="3"
            class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100"
            placeholder="Setting value"
          ></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Type</label>
            <select
              id="setting-type"
              required
              class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100"
            >
              <option value="string">String</option>
              <option value="integer">Integer</option>
              <option value="float">Float</option>
              <option value="boolean">Boolean</option>
              <option value="json">JSON</option>
              <option value="array">Array</option>
            </select>
          </div>

          <div>
            <label class="flex items-center gap-2 text-gray-700 dark:text-gray-300 mt-7">
              <input type="checkbox" id="setting-is-public" />
              <span class="text-sm font-medium">Public (non-admins can read)</span>
            </label>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Description</label>
          <input
            type="text"
            id="setting-description"
            class="w-full px-3 py-2 border rounded dark:bg-gray-700 dark:border-gray-600 dark:text-gray-100"
            placeholder="Optional description"
          />
        </div>

        <div class="flex justify-end gap-3 pt-4">
          <button
            type="button"
            id="cancel-btn"
            class="px-4 py-2 rounded border dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700"
          >
            Save
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'

    const statusEl = document.getElementById('status')
    const tbody = document.getElementById('settings-body')
    const modal = document.getElementById('setting-modal')
    const modalTitle = document.getElementById('modal-title')
    const form = document.getElementById('setting-form')
    const addBtn = document.getElementById('add-setting-btn')
    const cancelBtn = document.getElementById('cancel-btn')

    const setStatus = (msg, isError = false) => {
      statusEl.textContent = msg
      statusEl.className = isError
        ? 'mb-4 text-sm text-red-600'
        : 'mb-4 text-sm text-gray-600 dark:text-gray-300'
    }

    const getCookie = (name) => {
      const m = document.cookie.match(new RegExp(`(?:^|; )${name}=([^;]*)`))
      return m ? decodeURIComponent(m[1]) : ''
    }

    const ensureCsrfCookie = async () => {
      if (!getCookie('XSRF-TOKEN')) {
        await fetch(`${API}/sanctum/csrf-cookie`, { credentials: 'include' })
      }
    }

    const renderSettings = (settings) => {
      tbody.innerHTML = ''
      for (const s of settings) {
        const tr = document.createElement('tr')
        tr.className = 'border-t'

        // Truncate value for display
        const displayValue = s.value?.length > 50
          ? s.value.substring(0, 50) + '...'
          : s.value || '(null)'

        tr.innerHTML = `
          <td class="px-4 py-2 font-mono text-sm">${s.key}</td>
          <td class="px-4 py-2 text-sm">
            <input
              type="text"
              value="${displayValue || ''}"
              data-id="${s.id}"
              data-type="${s.type}"
              class="quick-edit w-full px-2 py-1 border rounded dark:bg-gray-700 dark:border-gray-600"
              ${!isScalarType(s.type) ? 'disabled' : ''}
            />
          </td>
          <td class="px-4 py-2 text-sm">${s.type}</td>
          <td class="px-4 py-2 text-sm">${s.is_public ? '✓' : ''}</td>
          <td class="px-4 py-2 text-sm text-gray-600 dark:text-gray-400">${s.description || ''}</td>
          <td class="px-4 py-2 text-sm">
            <button class="edit-btn px-2 py-1 rounded bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 hover:bg-blue-200 dark:hover:bg-blue-800 mr-2" data-id="${s.id}">Edit</button>
            <button class="delete-btn px-2 py-1 rounded bg-red-100 dark:bg-red-900 text-red-700 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-800" data-id="${s.id}">Delete</button>
          </td>
        `
        tbody.appendChild(tr)
      }

      if (!settings.length) {
        tbody.innerHTML = `<tr><td class="px-4 py-3" colspan="6">No settings found. Click "Add Setting" to create one.</td></tr>`
      }

      // Attach event listeners for quick edit
      document.querySelectorAll('.quick-edit').forEach(input => {
        input.addEventListener('blur', handleQuickEdit)
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.target.blur()
          }
        })
      })

      // Attach event listeners for edit/delete buttons
      document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', (e) => editSetting(e.target.dataset.id))
      })
      document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', (e) => deleteSetting(e.target.dataset.id))
      })
    }

    const isScalarType = (type) => {
      return ['string', 'integer', 'float', 'boolean'].includes(type)
    }

    const handleQuickEdit = async (e) => {
      const input = e.target
      const id = input.dataset.id
      const newValue = input.value

      try {
        await ensureCsrfCookie()
        const xsrf = getCookie('XSRF-TOKEN')
        if (!xsrf) throw new Error('Missing XSRF-TOKEN')

        const res = await fetch(`${API}/api/admin/settings/${id}`, {
          method: 'PUT',
          credentials: 'include',
          headers: {
            'accept': 'application/json',
            'content-type': 'application/json',
            'x-requested-with': 'XMLHttpRequest',
            'x-xsrf-token': xsrf,
          },
          body: JSON.stringify({ value: newValue }),
        })

        if (!res.ok) {
          const data = await res.json().catch(() => ({}))
          throw new Error(data?.message || `${res.status}`)
        }

        setStatus('Setting updated ✓')
        setTimeout(() => setStatus(''), 2000)
      } catch (err) {
        setStatus(`Error: ${err.message}`, true)
        loadSettings() // Reload to reset the value
      }
    }

    const openModal = (settingData = null) => {
      if (settingData) {
        modalTitle.textContent = 'Edit Setting'
        document.getElementById('setting-id').value = settingData.id
        document.getElementById('setting-key').value = settingData.key
        document.getElementById('setting-key').disabled = true
        document.getElementById('setting-value').value = settingData.value || ''
        document.getElementById('setting-type').value = settingData.type
        document.getElementById('setting-description').value = settingData.description || ''
        document.getElementById('setting-is-public').checked = settingData.is_public
      } else {
        modalTitle.textContent = 'Add Setting'
        form.reset()
        document.getElementById('setting-id').value = ''
        document.getElementById('setting-key').disabled = false
      }
      modal.classList.remove('hidden')
    }

    const closeModal = () => {
      modal.classList.add('hidden')
      form.reset()
    }

    const editSetting = async (id) => {
      try {
        const res = await fetch(`${API}/api/admin/settings/${id}`, {
          credentials: 'include',
          headers: { accept: 'application/json' },
        })

        if (!res.ok) throw new Error(`${res.status}`)

        const setting = await res.json()
        openModal(setting)
      } catch (err) {
        setStatus(`Error loading setting: ${err.message}`, true)
      }
    }

    const deleteSetting = async (id) => {
      if (!confirm('Are you sure you want to delete this setting?')) return

      try {
        await ensureCsrfCookie()
        const xsrf = getCookie('XSRF-TOKEN')
        if (!xsrf) throw new Error('Missing XSRF-TOKEN')

        const res = await fetch(`${API}/api/admin/settings/${id}`, {
          method: 'DELETE',
          credentials: 'include',
          headers: {
            'accept': 'application/json',
            'x-requested-with': 'XMLHttpRequest',
            'x-xsrf-token': xsrf,
          },
        })

        if (!res.ok) throw new Error(`${res.status}`)

        setStatus('Setting deleted ✓')
        loadSettings()
      } catch (err) {
        setStatus(`Error deleting setting: ${err.message}`, true)
      }
    }

    const loadSettings = async () => {
      try {
        const res = await fetch(`${API}/api/admin/settings`, {
          credentials: 'include',
          headers: { accept: 'application/json' },
        })

        if (res.status === 401) {
          window.location.href = '/login'
          return
        }

        if (res.status === 403) {
          window.location.href = '/'
          return
        }

        if (!res.ok) {
          setStatus(`Failed to load settings (${res.status})`, true)
          return
        }

        const settings = await res.json()
        renderSettings(settings)
        setStatus(`Loaded ${settings.length} settings.`)
      } catch (err) {
        setStatus(`Error: ${err?.message ?? err}`, true)
      }
    }

    // Event listeners
    addBtn.addEventListener('click', () => openModal())
    cancelBtn.addEventListener('click', closeModal)

    form.addEventListener('submit', async (e) => {
      e.preventDefault()

      const id = document.getElementById('setting-id').value
      const data = {
        key: document.getElementById('setting-key').value,
        value: document.getElementById('setting-value').value || null,
        type: document.getElementById('setting-type').value,
        description: document.getElementById('setting-description').value || null,
        is_public: document.getElementById('setting-is-public').checked,
      }

      try {
        await ensureCsrfCookie()
        const xsrf = getCookie('XSRF-TOKEN')
        if (!xsrf) throw new Error('Missing XSRF-TOKEN')

        const url = id ? `${API}/api/admin/settings/${id}` : `${API}/api/admin/settings`
        const method = id ? 'PUT' : 'POST'

        const res = await fetch(url, {
          method,
          credentials: 'include',
          headers: {
            'accept': 'application/json',
            'content-type': 'application/json',
            'x-requested-with': 'XMLHttpRequest',
            'x-xsrf-token': xsrf,
          },
          body: JSON.stringify(data),
        })

        const result = await res.json().catch(() => ({}))
        if (!res.ok) {
          throw new Error(result?.message || `${res.status}`)
        }

        setStatus(id ? 'Setting updated ✓' : 'Setting created ✓')
        closeModal()
        loadSettings()
      } catch (err) {
        setStatus(`Error: ${err.message}`, true)
      }
    })

    // Close modal on background click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal()
    })

    // Initial load
    loadSettings()
  </script>
</Layout>
