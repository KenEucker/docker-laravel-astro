# --- Docker / app config ---
#APP_ENV=production
APP_NAME=LarAstro
APP_ENV=local
APP_DEBUG=true
APP_DEBUG=false

# Public (what the browser sees)
APP_URL=http://admin.local.test
PUBLIC_API_URL=http://admin.local.test
FRONTEND_URL=http://intranet.local.test
PUBLIC_SITE_URL=http://intranet.local.test

# --- Sanctum / session for headless frontend ---
SANCTUM_STATEFUL_DOMAINS=intranet.local.test,admin.local.test
SESSION_DOMAIN=local.test
SESSION_DRIVER=file

# Optional: internal URL for SSR / server-to-server (Astro container -> Laravel container)
API_INTERNAL_URL=http://laravel:8000

# --- Database (container-to-container uses 3306) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# --- Default user seeding (gate it!) ---
SEED_DEFAULT_USER=true
DEFAULT_USER_NAME=Admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=change-me

# --- Mail configuration ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=

# --- Proxy configuration ---
CADDY_GLOBAL_OPTIONS=auto_https off
