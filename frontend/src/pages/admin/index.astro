---
import Layout from '../../layouts/Layout.astro'
import { requireAuth } from '../../lib/auth'

// Protect this route (server-side)
const user = await requireAuth(Astro)
if (user.redirected === false) {
  return user
}

// Adjust this check to match your user shape
const isAdmin =
  user?.role === 'admin' ||
  user?.roles?.includes?.('admin') ||
  user?.permissions?.includes?.('admin')

if (!isAdmin) {
  return Astro.redirect('/dashboard')
}

// Define your admin pages here (add/remove as you build features)
const adminLinks = [
  {
    href: '/admin/users',
    title: 'Users',
    description: 'View users, edit roles and permissions.',
  },
  {
    href: '/admin/settings',
    title: 'Settings',
    description: 'Manage application settings.',
  },
  {
    href: '/admin/audit',
    title: 'Audit Log',
    description: 'Review administrative actions and events.',
  },
]
---

<Layout title="Admin" isLoggedIn={true}>
  <div class="min-h-screen bg-gray-100 dark:bg-gray-900">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-start justify-between gap-6">
        <div>
          <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-white">
            Admin Dashboard
          </h1>
          <p class="mt-2 text-gray-600 dark:text-gray-300">
            Admin-only tools and management pages.
          </p>
        </div>

        <a
          href="/dashboard"
          class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-gray-900 dark:hover:text-white underline underline-offset-4"
        >
          Back to Dashboard
        </a>
      </div>

      <section class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {adminLinks.map((link) => (
          <a
            href={link.href}
            class="group block rounded-xl bg-white dark:bg-gray-800 shadow-sm hover:shadow-md border border-gray-200 dark:border-gray-700 p-6 transition"
          >
            <div class="flex items-center justify-between gap-4">
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:underline underline-offset-4">
                {link.title}
              </h2>
            </div>

            <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">
              {link.description}
            </p>
          </a>
        ))}
      </section>
    </main>
  </div>
</Layout>
