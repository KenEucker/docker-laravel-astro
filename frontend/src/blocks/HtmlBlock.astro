---
/**
 * HTML Block Renderer
 *
 * Renders raw HTML content.
 * WARNING: This should only be used for trusted content from admins.
 * The backend enforces permission gates for this block type.
 */

import DOMPurify from 'isomorphic-dompurify';

interface Props {
  data: {
    html: string;
  };
}

const { data } = Astro.props;

// Sanitize HTML to remove dangerous scripts
// Note: Backend already restricts this to trusted users,
// but we add an extra layer of protection here
const sanitizedHtml = DOMPurify.sanitize(data.html, {
  FORBID_TAGS: ['script', 'iframe', 'object', 'embed'],
  FORBID_ATTR: ['onerror', 'onload', 'onclick'],
});
---

<div class="html-block">
  <div set:html={sanitizedHtml} />
</div>
