---
/**
 * Rich Text Block Renderer
 *
 * Renders markdown-formatted content safely.
 * Markdown is converted to HTML and sanitized.
 */

import { marked } from 'marked';
import DOMPurify from 'isomorphic-dompurify';

interface Props {
  data: {
    markdown: string;
  };
}

const { data } = Astro.props;

// Configure marked for safe rendering
marked.setOptions({
  breaks: true,
  gfm: true,
});

// Convert markdown to HTML
const rawHtml = await marked.parse(data.markdown);

// Sanitize the HTML
const sanitizedHtml = DOMPurify.sanitize(rawHtml, {
  ALLOWED_TAGS: [
    'p', 'br', 'strong', 'em', 'u', 's', 'a', 'ul', 'ol', 'li',
    'h1', 'h2', 'h3', 'h4', 'h5', 'h6',
    'blockquote', 'code', 'pre', 'hr', 'table', 'thead', 'tbody', 'tr', 'th', 'td',
  ],
  ALLOWED_ATTR: ['href', 'title', 'target', 'rel'],
});
---

<div class="prose prose-lg max-w-none">
  <div set:html={sanitizedHtml} />
</div>
