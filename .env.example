# --- Docker / app config ---
#APP_ENV=production
APP_NAME=LarAstro
APP_ENV=local
APP_DEBUG=true
APP_DEBUG=false
APP_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database (container-to-container uses 3306) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret
MYSQL_ROOT_PASSWORD=rootsecret

# --- Sanctum / session for headless frontend ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost
SESSION_DRIVER=cookie

# --- Default user seeding (gate it!) ---
SEED_DEFAULT_USER=true
DEFAULT_USER_NAME=Admin
DEFAULT_USER_EMAIL=admin@example.com
DEFAULT_USER_PASSWORD=change-me

# --- Mail configuration ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=