    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.6",
    "isomorphic-dompurify": "^2.34.0",
    "marked": "^17.0.1",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.26"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^0.34.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0",
    "prettier-plugin-astro": "^0.14.0"
  }
