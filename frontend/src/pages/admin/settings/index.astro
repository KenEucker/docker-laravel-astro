---
import Layout from '../../../layouts/Layout.astro'
import { requireAdmin } from '../../../lib/auth'

const admin = await requireAdmin(Astro)
if (admin.redirected === false) {
  return admin
}

// Hybrid approach:
// - SSR blocks non-admins immediately (above)
// - Table data loads client-side (below) using browser cookies automatically
---

<Layout title="Admin · Settings" isLoggedIn={true} isAdmin={admin.is_admin}>
  <div class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex justify-between items-center mb-6">
      <div>
        <h1 class="text-2xl font-bold mb-2">Application Settings</h1>
        <p class="text-sm text-gray-600 dark:text-gray-300">
          Manage application-wide settings. Database values override environment variables.
        </p>
      </div>
    </div>

    <div id="status" class="mb-4 text-sm text-gray-600 dark:text-gray-300"></div>

    <div class="overflow-x-auto rounded-lg border">
      <table class="w-full border-collapse">
        <thead class="bg-gray-100 dark:bg-gray-800">
          <tr>
            <th class="text-left px-4 py-2">Key</th>
            <th class="text-left px-4 py-2">Value</th>
            <th class="text-left px-4 py-2">Type</th>
            <th class="text-left px-4 py-2">Public</th>
            <th class="text-left px-4 py-2">Description</th>
            <th class="text-left px-4 py-2">Actions</th>
          </tr>
        </thead>
        <tbody id="settings-body">
          <tr><td class="px-4 py-3" colspan="6">Loading…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const API = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000'

    const statusEl = document.getElementById('status')
    const tbody = document.getElementById('settings-body')

    const setStatus = (msg, isError = false) => {
      statusEl.textContent = msg
      statusEl.className = isError
        ? 'mb-4 text-sm text-red-600'
        : 'mb-4 text-sm text-gray-600 dark:text-gray-300'
    }

    const renderSettings = (settings) => {
      tbody.innerHTML = ''
      for (const s of settings) {
        const tr = document.createElement('tr')
        tr.className = 'border-t'

        // Truncate value for display
        const displayValue = s.value?.length > 50
          ? s.value.substring(0, 50) + '...'
          : s.value || '(null)'

        tr.innerHTML = `
          <td class="px-4 py-2 font-mono text-sm">${s.key}</td>
          <td class="px-4 py-2 text-sm">
            <input
              type="text"
              value="${displayValue || ''}"
              readonly
              data-id="${s.id}"
              data-type="${s.type}"
              class="quick-edit w-full px-2 py-1 border rounded dark:bg-gray-700 dark:border-gray-600"
              ${!isScalarType(s.type) ? 'disabled' : ''}
            />
          </td>
          <td class="px-4 py-2 text-sm">${s.type}</td>
          <td class="px-4 py-2 text-sm">${s.is_public ? '✓' : ''}</td>
          <td class="px-4 py-2 text-sm text-gray-600 dark:text-gray-400">${s.description || ''}</td>
          <td class="px-4 py-2"><a class="px-3 py-1 rounded bg-gray-200 dark:bg-gray-700" href="/admin/settings/${s.id}">Edit</a></td>
        `
        tbody.appendChild(tr)
      }

      if (!settings.length) {
        tbody.innerHTML = `<tr><td class="px-4 py-3" colspan="6">No settings found. Click "Add Setting" to create one.</td></tr>`
      }
    }

    const isScalarType = (type) => {
      return ['string', 'integer', 'float', 'boolean'].includes(type)
    }

    const loadSettings = async () => {
      try {
        const res = await fetch(`${API}/api/admin/settings`, {
          credentials: 'include',
          headers: { accept: 'application/json' },
        })

        if (res.status === 401) {
          window.location.href = '/login'
          return
        }

        if (res.status === 403) {
          window.location.href = '/'
          return
        }

        if (!res.ok) {
          setStatus(`Failed to load settings (${res.status})`, true)
          return
        }

        const settings = await res.json()
        renderSettings(settings)
        setStatus(`Loaded ${settings.length} settings.`)
      } catch (err) {
        setStatus(`Error: ${err?.message ?? err}`, true)
      }
    }

    // Initial load
    loadSettings()
  </script>
</Layout>
